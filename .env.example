# Environment Configuration
# Copy this file to ".env" and fill in your actual values.

# ------------------------------------------------------------------
# OpenTelemetry / Dynatrace OTLP Export Configuration
# ------------------------------------------------------------------

# Name of the service as it will appear in your observability backend
OTEL_SERVICE_NAME=cryptic-core-engine

# Dynatrace OTLP ingest endpoint.
# Replace <TENANT_ID> with your actual Dynatrace tenant ID.
OTEL_EXPORTER_OTLP_ENDPOINT=https://<TENANT_ID>.live.dynatrace.com/api/v2/otlp

# Dynatrace API Token used for authenticating OTLP ingestion.
# Replace <API_TOKEN> with your actual Dynatrace API token.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Api-Token <API_TOKEN>

# Protocol used to send telemetry data. Dynatrace expects http/protobuf.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ------------------------------------------------------------------
# Optional: Local Development (Jaeger via Docker Compose)
# ------------------------------------------------------------------
# Uncomment these and comment out the Dynatrace values above
# if you want to trace locally instead of sending to Dynatrace.

# OTEL_SERVICE_NAME=cryptic-core
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=none
# OTEL_LOGS_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
